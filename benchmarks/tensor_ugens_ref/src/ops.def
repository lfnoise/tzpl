//
//  ops.def
//  tensor-ugens
//
//  The elementwise ops on S, one per line. Not a normal header: ops.hpp and
//  ops.cpp each define the DEF_* macros and include this, to declare and to
//  define every op.
//

DEF_PREFIX_UNOP(neg, -)

// trigonometric
DEF_STD_UNOP(sin)
DEF_STD_UNOP(cos)
DEF_STD_UNOP(tan)
DEF_STD_UNOP(asin)
DEF_STD_UNOP(acos)
DEF_STD_UNOP(atan)

// hyperbolic
