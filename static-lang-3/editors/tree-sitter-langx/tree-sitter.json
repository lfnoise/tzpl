{
  "grammars": [
    {
      "name": "langx",
      "camelcase": "Langx",
      "scope": "source.langx",
      "path": ".",
      "file-types": [
        "x"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(langx|x)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Language X",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-langx"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
