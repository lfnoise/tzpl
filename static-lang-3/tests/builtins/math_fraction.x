-- Fraction math builtins

-- Basic
println(1/2);
println(1/3);
println(2/4);

-- Arithmetic
println(1/2 + 1/3);
println(1/2 - 1/3);
println(1/2 * 1/3);
println((1/2) / (1/3));

-- abs
(-1/2) abs println;
(1/2) abs println;

-- min, max
println(min(1/3, 1/2));
println(max(1/3, 1/2));

-- Comparison
println(1/2 > 1/3);
println(1/3 < 1/2);
println(1/2 == 2/4);
println(1/2 != 1/3);
