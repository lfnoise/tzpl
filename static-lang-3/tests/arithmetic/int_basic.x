-- Basic integer arithmetic

-- Addition
println(1 + 2);
println(0 + 0);
println(-1 + 1);
println(100 + 200);
println(-50 + -50);

-- Subtraction
println(5 - 3);
println(3 - 5);
println(0 - 0);
println(100 - 1);
println(-10 - -10);

-- Multiplication
println(2 * 3);
println(0 * 100);
println(-3 * 4);
println(-3 * -4);
println(1 * 1);
println(7 * 1);

-- Integer division
println(10 // 3);
println(10 // 2);
println(0 // 5);
println(7 // 1);
println(100 // 10);
println(-7 // 2);

-- Modulo
println(10 % 3);
println(10 % 2);
println(7 % 7);
println(0 % 5);
println(17 % 5);
println(100 % 7);

-- Unary negation
println(-42);
println(-(-42));
println(-(3 * 4));
println(-0);
println(-1);
