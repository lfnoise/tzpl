-- Basic float arithmetic

-- Addition
println(1.0 + 2.0);
println(0.5 + 0.5);
println(-1.5 + 1.5);
println(3.14 + 2.86);

-- Subtraction
println(5.0 - 3.0);
println(3.0 - 5.0);
println(1.5 - 0.5);
println(0.0 - 0.0);

-- Multiplication
println(2.0 * 3.0);
println(0.5 * 4.0);
println(-2.0 * 3.0);
println(-2.0 * -3.0);
println(0.0 * 100.0);
println(1.0 * 42.0);

-- Division
println(10.0 / 2.0);
println(7.0 / 2.0);
println(1.0 / 3.0);
println(0.0 / 1.0);

-- Unary negation
println(-3.14);
println(-(-3.14));
println(-0.0);
