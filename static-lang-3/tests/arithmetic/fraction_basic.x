-- Basic fraction arithmetic (Int / Int produces Fraction)

-- Construction
println(1 / 2);
println(1 / 3);
println(2 / 4);
println(3 / 1);
println(0 / 5);

-- Addition
println(1/2 + 1/3);
println(1/4 + 3/4);
println(1/2 + 1/2);
println(1/6 + 1/6);

-- Subtraction
println(3/4 - 1/4);
println(1/2 - 1/3);
println(1/3 - 1/2);

-- Multiplication
println(1/2 * 1/3);
println(2/3 * 3/4);
println(1/2 * 2/1);

-- Division
println((1/2) / (1/3));
println((3/4) / (3/8));

-- Negation
println(-(1/2));
println(-(-(1/2)));

-- Fraction with int operations
println(1/2 + 1);
println(2 + 1/3);
println(1/2 * 3);
