-- Numeric Tower from Language X by Example

-- Int division produces a fraction
let half = 1 / 2;
let third = 1 / 3;
let sum = half + third;
half println;
third println;
sum println;

-- Int + float promotes to float
let x = 2 + 3.5;
x println;

-- Imaginary literals create complex numbers
let z = 3.0 + 4i;
let w = Complex(1.0, -1.0);
z println;
w println;
