-- Fraction via for-loop --
1/1
1/2
1/3
-- Fraction via next --
Option<Fraction>.some(1/1)
Option<Fraction>.some(1/2)
Option<Fraction>.some(1/3)
Option<Fraction>.none
-- Fraction via toList --
List(1/1, 1/2, 1/3)
-- Tuple via for-loop --
(0, 0)
(1, 1)
(2, 4)
-- Tuple via next --
Option<(Int, Int)>.some(0, 0)
Option<(Int, Int)>.some(1, 1)
Option<(Int, Int)>.some(2, 4)
Option<(Int, Int)>.none
-- Tuple via toList --
List((0, 0), (1, 1), (2, 4))
-- Struct via for-loop --
Point { x: 0, y: 0 }
Point { x: 1, y: 1 }
Point { x: 2, y: 4 }
-- Struct via toList --
List(Point { x: 0, y: 0 }, Point { x: 1, y: 1 }, Point { x: 2, y: 4 })
