-- Comparison operators

-- Integer comparisons
println(1 < 2);
println(2 < 1);
println(1 < 1);
println(1 <= 1);
println(1 <= 2);
println(2 <= 1);
println(2 > 1);
println(1 > 2);
println(1 > 1);
println(1 >= 1);
println(2 >= 1);
println(1 >= 2);

-- Equality
println(1 == 1);
println(1 == 2);
println(1 != 2);
println(1 != 1);

-- Float comparisons
println(1.0 < 2.0);
println(2.0 < 1.0);
println(1.5 <= 1.5);
println(2.0 > 1.0);
println(1.5 >= 1.5);
println(1.0 == 1.0);
println(1.0 != 2.0);

-- String comparisons
println("apple" < "banana");
println("banana" < "apple");
println("abc" == "abc");
println("abc" != "abd");
println("abc" <= "abc");
println("abc" >= "abc");

-- Boolean comparisons
println(true == true);
println(false == false);
println(true == false);
println(true != false);

-- Negative numbers
println(-5 < 0);
println(-5 < -3);
println(-3 > -5);
println(0 > -1);
