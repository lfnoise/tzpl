{
  "name": "tzpl",
  "displayName": "Tzopilotl",
  "description": "Syntax highlighting for Tzopilotl (.x files)",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "tzpl",
        "aliases": ["Tzopilotl", "tzpl"],
        "extensions": [".x"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tzpl",
        "scopeName": "source.x",
        "path": "./syntaxes/tzpl.tmLanguage.json"
      }
    ]
  }
}
