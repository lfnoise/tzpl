{
  "grammars": [
    {
      "name": "tzpl",
      "camelcase": "Langx",
      "scope": "source.tzpl",
      "path": ".",
      "file-types": [
        "x"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(tzpl|x)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Tzopilotl",
    "links": {
      "repository": "https://github.com/lfnoise/tzpl"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
